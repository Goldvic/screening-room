# Copy this file to  deploy/.env  and fill it in.

# The address people type, with no https://  (see README step 1 for a free one)
DOMAIN=cinemamovies.duckdns.org

# Where your videos are on the VPS (a folder path on the VPS itself)
MEDIA_DIR=/home/ubuntu/media_downloader/data/downloads


# Names shown in Cinema = folders INSIDE that media folder, written as /media/<folder>.  Separate several with commas.
MEDIA_ROOTS=Downloads=/media

# Watch-only code (phone, TV, family). Can see and play everything, cannot change anything.
ACCESS_PIN=24617

# Your own password. Full access. Make it long.
ADMIN_PASSWORD=spartanvictor2461
