{
  "name": "cinema-desktop",
  "version": "1.0.0",
  "description": "Cinema desktop app",
  "author": "you",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cinema.app",
    "productName": "Cinema",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "directories": { "output": "release" }
  }
}